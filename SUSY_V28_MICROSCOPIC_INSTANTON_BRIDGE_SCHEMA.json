  "additionalProperties": false,
  "properties": {
    "all_bridge_checks_pass": {
      "const": true
    },
    "axion_charge_matrix_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "charged_zero_mode_audit_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "global_consistency_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "instanton_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "moduli_inventory": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "axion_period": {
            "minLength": 1,
            "type": "string"
          },
          "divisor_id": {
            "minLength": 1,
            "type": "string"
          },
          "modulus_id": {
            "minLength": 1,
            "type": "string"
          },
          "stabilization_source": {
            "minLength": 1,
            "type": "string"
          }
