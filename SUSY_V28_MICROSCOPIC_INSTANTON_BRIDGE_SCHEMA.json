    },
    "orientifold_parity_split_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "vacuum_hessian": {
      "additionalProperties": false,
      "properties": {
        "complex_dimension": {
          "const": 51
        },
        "complex_rank": {
          "const": 51
        },
        "positive_physical_spectrum": {
          "const": true
        },
        "real_rank": {
          "const": 102
        }
      },
      "required": [
        "complex_dimension",
        "complex_rank",
        "real_rank",
        "positive_physical_spectrum"
      ],
      "type": "object"
    },
    "visible_matching_sha256": {
      "pattern": "^[0-9a-f]{64}$",
