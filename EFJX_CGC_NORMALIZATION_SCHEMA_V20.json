{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EFJX_CGC_NORMALIZATION_SCHEMA_V20.json",
  "title": "E/F/J/X physical Clebsch normalization evidence",
  "type": "object",
  "required": [
    "schema_version",
    "invariant",
    "contraction",
    "field_normalizations",
    "singlet_vev_projection",
    "gamma_mapping",
    "source_manifest",
    "acceptance_evidence",
    "artifact_hashes",
    "efjx_slot_match",
    "physical_EW_reminimization",
    "closure_complete",
    "n_failed"
  ],
  "properties": {
    "schema_version": {"const": "efjx-cgc-normalization-v2"},
    "invariant": {"const": "Phi210_H10_Sigmabar126_S"},
    "contraction": {"type": "string", "minLength": 41},
    "field_normalizations": {
      "type": "object",
      "required": ["Phi210", "H10", "Sigmabar126", "S"],
      "properties": {
        "Phi210": {
          "type": "object",
          "required": ["kinetic_convention", "antisymmetry_convention", "state_basis_artifact"]
        },
        "H10": {
          "type": "object",
          "required": ["kinetic_convention", "state_basis_artifact"]
        },
        "Sigmabar126": {
          "type": "object",
          "required": ["kinetic_convention", "duality_convention", "epsilon_convention", "state_basis_artifact"]
        },
        "S": {
          "type": "object",
          "required": ["kinetic_convention", "real_or_complex_convention", "state_basis_artifact"]
        }
      },
      "additionalProperties": false
    },
    "singlet_vev_projection": {
      "type": "object",
      "required": ["p", "a", "omega", "vS", "hEW", "units", "projection_artifact"],
      "properties": {
        "p": {"type": "number"},
        "a": {"type": "number"},
        "omega": {"type": "number"},
        "vS": {"type": "number"},
        "hEW": {"const": 174.0},
        "units": {"const": "GeV"},
        "projection_artifact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gamma_mapping": {
      "type": "object",
      "required": ["gamma_eff_over_lambda4", "sign", "phase_convention", "mapping_artifact"],
      "properties": {
        "gamma_eff_over_lambda4": {"type": "number", "not": {"const": 0}},
        "sign": {"enum": [-1, 1]},
        "phase_convention": {"type": "string", "minLength": 1},
        "mapping_artifact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source_manifest": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["citation", "use", "locator"],
        "properties": {
          "citation": {"type": "string", "minLength": 1},
          "use": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "acceptance_evidence": {
      "type": "object",
      "required": [
        "canonical_kinetic_normalization",
        "direct_tensor_contraction",
        "independent_matrix_reconstruction",
        "physical_EW_branch_reminimized",
        "non_goldstone_spectrum_positive"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["criterion", "passed", "artifacts"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "passed": {"const": true},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "efjx_slot_match": {
      "type": "object",
      "required": ["E", "F", "J", "X"],
      "additionalProperties": {
        "type": "object",
        "required": ["max_abs_residual_GeV", "tolerance_GeV", "passed", "artifact"],
        "properties": {
          "max_abs_residual_GeV": {"type": "number", "minimum": 0},
          "tolerance_GeV": {"type": "number", "exclusiveMinimum": 0},
          "passed": {"const": true},
          "artifact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "physical_EW_reminimization": {
      "type": "object",
      "required": [
        "hEW_GeV",
        "stationarity_residual_GeV3",
        "stationarity_tolerance_GeV3",
        "gauge_goldstone_count",
        "min_non_goldstone_eigenvalue_GeV2",
        "efjx_thresholds_passed",
        "competing_extrema_checked",
        "boundedness_checked",
        "artifact"
      ],
      "properties": {
        "hEW_GeV": {"const": 174.0},
        "stationarity_residual_GeV3": {"type": "number", "minimum": 0},
        "stationarity_tolerance_GeV3": {"type": "number", "exclusiveMinimum": 0},
        "gauge_goldstone_count": {"const": 33},
        "min_non_goldstone_eigenvalue_GeV2": {"type": "number", "exclusiveMinimum": 0},
        "efjx_thresholds_passed": {"const": true},
        "competing_extrema_checked": {"const": true},
        "boundedness_checked": {"const": true},
        "artifact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "closure_complete": {"const": true},
    "n_failed": {"const": 0}
  },
  "additionalProperties": true
}
