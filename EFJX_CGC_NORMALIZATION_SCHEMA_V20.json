{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EFJX_CGC_NORMALIZATION_SCHEMA_V20.json",
  "title": "Retired E/F/J/X CGC normalization contract",
  "description": "This schema is deliberately non-closing. Aulakh E/F/J/X are mixed chiral-gauge fermion/gaugino matrices and cannot serve as a non-supersymmetric scalar lambda4 normalization target.",
  "type": "object",
  "required": [
    "schema_version",
    "retired",
    "closure_complete",
    "reason",
    "invalid_target",
    "replacement_artifacts",
    "whole_model_validated",
    "whole_model_excluded"
  ],
  "properties": {
    "schema_version": {
      "const": "efjx-cgc-normalization-retired-v3"
    },
    "retired": {
      "const": true
    },
    "closure_complete": {
      "const": false
    },
    "reason": {
      "type": "string",
      "minLength": 40
    },
    "invalid_target": {
      "const": "Aulakh_E_F_J_X_mixed_chiral_gauge_fermion_gaugino_matrices"
    },
    "forbidden_closure_fields": {
      "type": "array",
      "contains": {
        "const": "efjx_slot_match"
      },
      "minItems": 2
    },
    "replacement_artifacts": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        {
          "contains": {
            "const": "DIRECT_PHI_H_SIGMABAR_TENSOR_V20.json"
          }
        },
        {
          "contains": {
            "const": "DIRECT_PHI_H_SIGMABAR_TD_CROSSCHECK_V20.json"
          }
        }
      ]
    },
    "remaining_required_artifacts": {
      "type": "array",
      "minItems": 3
    },
    "whole_model_validated": {
      "const": false
    },
    "whole_model_excluded": {
      "const": false
    }
  },
  "not": {
    "anyOf": [
      {"required": ["efjx_slot_match"]},
      {"required": ["gamma_mapping"]},
      {"properties": {"closure_complete": {"const": true}}}
    ]
  },
  "additionalProperties": true
}
